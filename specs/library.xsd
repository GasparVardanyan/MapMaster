<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <!-- start library -->
  <xs:element name="library">
    <xs:complexType>
      <xs:sequence>
        <!-- start prop-group -->
        <xs:element name="prop-group" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <!-- start prop -->
              <xs:element name="prop" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:choice>
                      <!-- start mesh -->
                      <xs:element name="mesh" minOccurs="1" maxOccurs="1">
                        <xs:complexType>
                          <xs:sequence>
                            <!-- start texture -->
                            <xs:element name="texture" minOccurs="0" maxOccurs="unbounded">
                              <xs:complexType>
                                <xs:attribute name="name" type="xs:string" use="required"/>
                                <xs:attribute name="diffuse-map" type="xs:string" use="required"/>
                              </xs:complexType>
                            </xs:element>
                            <!-- end texture -->
                          </xs:sequence>
                          <xs:attribute name="file" type="xs:string" use="required"/>
                        </xs:complexType>
                        <xs:unique name="unique-texture-names">
                          <xs:selector xpath="texture"/>
                          <xs:field xpath="@name"/>
                        </xs:unique>
                        <xs:unique name="unique-texture-files">
                          <xs:selector xpath="texture"/>
                          <xs:field xpath="@file"/>
                        </xs:unique>
                      </xs:element>
                      <!-- end mesh -->
                      <!-- start sprite -->
                      <xs:element name="sprite" minOccurs="1" maxOccurs="1">
                        <xs:complexType>
                          <xs:attribute name="file" type="xs:string" use="required"/>
                          <xs:attribute name="scale" type="xs:double" use="required"/>
                          <xs:attribute name="origin-y" type="xs:double" use="required"/>
                        </xs:complexType>
                      </xs:element>
                      <!-- end sprite -->
                    </xs:choice>
                  </xs:sequence>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                </xs:complexType>
                <xs:unique name="unique-mesh-files">
                  <xs:selector xpath="mesh"/>
                  <xs:field xpath="@file"/>
                </xs:unique>
                <xs:unique name="unique-sprite-files">
                  <xs:selector xpath="sprite"/>
                  <xs:field xpath="@file"/>
                </xs:unique>
              </xs:element>
              <!-- end prop -->
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
          </xs:complexType>
          <xs:unique name="unique-prop-names">
            <xs:selector xpath="prop"/>
            <xs:field xpath="@name"/>
          </xs:unique>
        </xs:element>
        <!-- end prop-group -->
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
    <xs:unique name="unique-prop-group-names">
      <xs:selector xpath="prop-group"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>
  <!-- end library -->
</xs:schema>
